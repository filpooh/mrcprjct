@{
    ViewData["Title"] = "Home Page";
}
@section Scripts {
    <script src="~/js/AddTable.js" asp-append-version="true"></script>
}
<div class="card">
    <div class="card-body">
        <div class="container mt-4 text-center">
            <div class="mb-3">
                <label class="form-label fw-bold">Upload CSV</label>
                <input type="file" id="csvFile" class="form-control ms-5" accept=".csv">
            </div>
            <!--riguardare come fare il submit in maniera più coerente-->
            
            <div class="mb-3">
                <div class="mt-3">
                    <!--deve essere compilato automaticamente non appena viene caricato il file-->
                    <label class="form-label fw-bold">table name</label>
                    <input id="table-name" class="form-control ms-5" />
                </div>
                <div id="csvResult" class="mt-4 d-flex flex-column align-items-center mt-3"></div>
                <div class="mt-3">
                    <!--deve essere più largo-->
                    <label class="form-label fw-bold">table description</label>
                    <input id="table-description" class="form-control ms-5" />
                </div>
            </div>
            <!--spazio per gli header-->
            <div class="d-flex justify-content-center nt-3">    
                <button id="sumbitTable" class="btn btn-primary mt-2" onclick="submitTable()" style="display:none">submit table</button>
            </div>
            <!--button class="btn btn-primary mt-2" onclick="UploadCsv()">Upload csv la function deve essere chiamata in auto dal js</button-->
        </div>
    </div>
