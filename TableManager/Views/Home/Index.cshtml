@page
@model TableManager.Views.Home.DashboardModel
@section Scripts {
    <script src="~/js/PartialViewUserTable.js" asp-append-version="true"></script>
}
<div id= "mainCards">
    <div class="d-flex col-12 px-3 mt-3"><!--togli col-->
        <div class="card me-3" style="width: 18rem;">
            <!--img src="..." class="card-img-top" alt="..."-->
            <a class="card-body text-decoration-none text-dark" asp-controller="Home" asp-action="AddTable">
                <h5 class="card-title">Importa csv</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
            </a>
        </div>
        <div class="card me-3" style="width: 18rem;">
            <button id="btnManageTables" class="btn w-100 p-0 border-0 bg-transparent text-dark text-decoration-none">
                <div class="card-body">
                    <h5 class="card-title">genera modello</h5>
                    <p class="card-text">
                        Some quick example text to build on the card title and make up the bulk of the card's content.
                    </p>
                </div>
            </button>
        </div>
    <!--/div>
    <div class="d-flex col-6 px-3 mt-3"-->
        <div class="card me-3" style="width: 18rem;">
            <!--img src="..." class="card-img-top" alt="..."-->
            <div class="card-body">
                <button id="btnManageModels" class="btn w-100 p-0 border-0 bg-transparent text-dark text-decoration-none">
                    <h5 class="card-title">lista modelli</h5>
                    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                </button>
            </div>
        </div>
    </div>
</div>
<!--sistemare css degli elementi-->
<div id ="subDiv" class="d-flex text-center" style="display:none;">
    <button id="btnBack" class="btn btn-outline-secondary my-3" style="display:none;">
        ← Back
    </button>
    <hi id="partialTitle" style ="display:none;"></h1>
</div>
<div id="tablesContainer" class="mt-4">
    <!-- Qui compariranno le card delle tabelle -->
</div>