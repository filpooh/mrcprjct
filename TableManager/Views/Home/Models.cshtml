@model ModelDto
@section Scripts {
    <script src="~/js/Model.js" asp-append-version="true"></script>
    <script src="~/js/ModelSettingPartial.js"></script>
    <!--script src="~/js/ModelStatPartial.js"></script>
        altri file js
    <script-- src="~/js/ModelTabs.js"></script-->
}
@if (Model == null)
{
    <p>Nessuna tabella trovata.</p>
}
else
{
    <div class="mt-3 mb-3">
        <label>File @Model.Name.ToUpper() </label>
    </div>
    <div class="card mt-3 mb-3">
        @if (Model.stato == -1)
        {
            <div class="card-body" style="background-color:red">
                <label>Errore generazione modello</label>
            </div>
        }
        @if (Model.stato == 1)
        {
            <div class="card-body" style="background-color:orange">
                <label>Modello in lavorazione"</label>    
            </div> 
        }
        @if (Model.stato == 2)
        {
            <div class="card-body" style="background-color:limegreen">
                <label>Modello completato</label>
            </div>        
        }

    </div>
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings"
                    type="button" role="tab">
                Settings
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="data-tab" data-bs-toggle="tab" data-bs-target="#data"
                    type="button" role="tab">
                Data
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="stat-tab" data-bs-toggle="tab" data-bs-target="#stat"
                    type="button" role="tab">
                Statistiche modelli generati
            </button>
        </li>
    </ul>
    <div class=" tab-content mt-3" id="tab-content">
        <div id="settings" class="tab-pane fade show active" role="tabpanel">
            <partial name="_ModelSettingsPartial" model="Model" />
        </div>
        <div id="data" class="text-center tab-pane fade" role="tabpanel">
            <partial name="_ModelDataPartial" model="Model" />
        </div>
        <div id="stat" class="text-center tab-pane fade" role="tabpanel">
            <partial name="_partialStatModel" model="Model" />
         </div>
    </div>
}
<div id="pageData" data-id="@Model.Id"></div><!--solo per passare l'id al js-->