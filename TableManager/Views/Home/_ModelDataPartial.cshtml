@model ModelDto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="mt-3 d-flex">
    <div class="ms-3">
        <button class="btn btn-primary">salva</button>
    </div>
    <div class="ms-3">
        <button id="edit-button" class="btn btn-primary">modifica valori</button>
        <button id="end-edit-button" class="btn btn-primary" style="display:none">fine modifica</button>
    </div>
</div>
<div class="mt-3 container">
    <div class="table-responsive">
        <table class="table table-hover table-bordered table-striped">
            <thead>
                <tr>
                    @foreach (var header in Model.HeaderJson)
                    {
                        <th>@header</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model.DataRow)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>@cell</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
