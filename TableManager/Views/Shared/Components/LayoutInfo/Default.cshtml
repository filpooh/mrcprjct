<!-- MENU CSV -->
@model List<TableManager.Models.dto.GenericDto>
<li class="nav-item">
    <a class="nav-link text-white d-flex justify-content-between align-items-center"
       data-bs-toggle="collapse"
       href="#menuCsv"
       role="button"
       aria-expanded="false"
       aria-controls="menuCsv">
        CSV Files
        <span class="ms-2">&#9662;</span>
    </a>

    <div class="collapse" id="menuCsv">
        <ul class="list-unstyled ms-3">
            @foreach (var item in Model.Where(x => x.Csv))
            {
                <li class="nav-item">
                    <a class="nav-link text-white"
                       asp-controller="Home"
                       asp-action="Table"
                       asp-route-id="@item.Id">
                        @item.Name
                    </a>
                </li>
            }
        </ul>
    </div>
</li>

<!-- MENU ML -->
<li class="nav-item mt-2">
    <a class="nav-link text-white d-flex justify-content-between align-items-center"
       data-bs-toggle="collapse"
       href="#menuMl"
       role="button"
       aria-expanded="false"
       aria-controls="menuMl">
        ML Tables
        <span class="ms-2">&#9662;</span>
    </a>

    <div class="collapse" id="menuMl">
        <ul class="list-unstyled ms-3">



            @foreach (var item in Model.Where(x => !x.Csv))
            {
                <li class="nav-item">
                    <a class="nav-link text-white"
                       asp-controller="Home"
                       asp-action="Models"
                       asp-route-id="@item.Id">
                        @item.Name
                    </a>
                </li>
            }
        </ul>
    </div>
</li>