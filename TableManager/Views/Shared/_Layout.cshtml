@using Microsoft.AspNetCore.Identity
@using TableManager.Data
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TableManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TableManager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!--nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-black border-bottom box-shadow mb-3"-->
        <nav class="navbar navbar-expand-sm navbar-dark bg-black box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">TableManager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a><!--da cancellare-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <!--sidebar-->
    @{
            //nascondo se è dashboard
            var action = ViewContext.RouteData.Values["action"]?.ToString();
            var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            //regola quando il layout è presente
            bool isDashboard = false;//action == "Index" && controller == "Home";
        }
    @if (SignInManager.IsSignedIn(User) && !isDashboard)
    {
        <div class="d-flex min-vh-100">
            <aside class="bg-black p-3 sidebar position-sticky" style="top:0; height:100vh; width:250px;">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="AddTable">Add Table</a>
                    </li>
                    @await Component.InvokeAsync("LayoutInfo")
                </ul>
            </aside>

            <main class="container col-10 p-4">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="container col-10 p-5">
            @RenderBody()
        </main>
    }
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TableManager - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
